# Example environment variables. Do NOT commit actual secrets.
# Copy to .env (or set these in your cloud provider's secret store)

# Blockstream / Bitcoin explorer
BLOCKSTREAM_API_URL=https://blockstream.info/api
BLOCKSTREAM_API_KEY=__BLOCKSTREAM_API_KEY_PLACEHOLDER__

# Blockchair (Bitcoin Cash / BCH)
BLOCKCHAIR_API_URL=https://api.blockchair.com
BLOCKCHAIR_API_KEY=__BLOCKCHAIR_API_KEY_PLACEHOLDER__

# Ethereum RPC (Alchemy / Infura / Llama)
ETH_RPC_URL=https://eth.llamarpc.com
ETH_RPC_KEY=__ETH_RPC_KEY_PLACEHOLDER__

# Firebase (if used)
FIREBASE_API_KEY=__FIREBASE_API_KEY_PLACEHOLDER__
FIREBASE_PROJECT_ID=__FIREBASE_PROJECT_ID_PLACEHOLDER__
FIREBASE_DATABASE_URL=__FIREBASE_DATABASE_URL_PLACEHOLDER__

# AI / internal keys
TRUST_WALLET_PREDICTION_KEY=__TRUST_WALLET_KEY_PLACEHOLDER__
AI_SERVICE_API_KEY=__AI_SERVICE_API_KEY_PLACEHOLDER__

# App secret (JWT signing) - rotate immediately if exposed
APP_JWT_SECRET=__APP_JWT_SECRET_PLACEHOLDER__

# Storage & deployment keys
S3_ACCESS_KEY_ID=__AWS_ACCESS_KEY_ID_PLACEHOLDER__
S3_SECRET_ACCESS_KEY=__AWS_SECRET_ACCESS_KEY_PLACEHOLDER__
SSH_DEPLOY_KEY_NAME=__SSH_DEPLOY_KEY_PLACEHOLDER__

# Labeling format suggestion (store your secrets metadata in your secrets manager):
# Tags: owner=TheJoker1982, env=prod|staging|dev, purpose=blockstream_reads, rotate_after=2025-12-01
